# Droplet data-plane secrets for deploy/digitalocean/docker-compose.yml
# Copy to .env on the Droplet (chmod 600). Never commit the real .env.

# Bind Postgres/Qdrant to loopback by default. For App Platform VPC access,
# set this to the Droplet's private IP (doctl compute droplet get …).
DROPLET_BIND_ADDR=127.0.0.1

POSTGRES_USER=carousel
POSTGRES_DB=carousel
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional: used by backup/restore scripts when not inferring from compose.
DATABASE_URL=postgresql://carousel:REPLACE_ME@127.0.0.1:5432/carousel
QDRANT_URL=http://127.0.0.1:6333

# Carousel Qdrant collections (all must be snapshotted).
QDRANT_COLLECTION=dfi_video_frames
QDRANT_IMAGES_COLLECTION=dfi_images
QDRANT_IMAGE_CAPTIONS_COLLECTION=dfi_image_captions
QDRANT_VIDEO_TRANSCRIPTS_COLLECTION=dfi_video_transcripts

# Local backup root on the Droplet (encrypted tarball lands here before Spaces).
BACKUP_DIR=/var/backups/dfi-carousel

# DigitalOcean Spaces (S3-compatible) — optional upload after local backup.
# Create a Spaces key with write access; leave empty to skip upload.
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=dfi-carousel-backups
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Age/GPG-style passphrase for openssl enc of the archive (required for upload).
BACKUP_ENCRYPTION_PASSPHRASE=

# --- App Platform / RunPod references (documentation only on the Droplet) ---
# Set these on the App Platform carousel-backend component, not here:
#   RUNPOD_API_KEY=
#   RUNPOD_WHISPER_ENABLED=true
#   RUNPOD_WHISPER_ENDPOINT_ID=
#   RUNPOD_FACE_GPU_ENABLED=true
#   RUNPOD_FACE_ENDPOINT_ID=
#   GEMINI_API_KEY=
#   ANTHROPIC_API_KEY=
#   CAROUSEL_GOOGLE_CLIENT_ID=
#   CAROUSEL_GOOGLE_CLIENT_SECRET=
#   CAROUSEL_GOOGLE_API_KEY=
#   CAROUSEL_GOOGLE_REDIRECT_URI=https://<backend-public>/auth/google/callback
#   CAROUSEL_FRONTEND_URL=https://<frontend-public>
#   DATABASE_URL=postgresql+asyncpg://carousel:<pw>@<droplet-private-ip>:5432/carousel
#   QDRANT_URL=http://<droplet-private-ip>:6333
