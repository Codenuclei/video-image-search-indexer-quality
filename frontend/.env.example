NEXT_PUBLIC_API_URL=http://localhost:8000
# OAuth client ID for the GIS login button. Backend accepts this via GOOGLE_ID_TOKEN_EXTRA_AUDIENCES
# when it differs from Drive OAuth GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Drive folder Picker uses backend GOOGLE_API_KEY via /api/drive-token — do not put the API key here.
NEXT_PUBLIC_SUPPORT_EMAIL=abhishek.ghosh1@mastersunion.org
# Signed httpOnly session cookie (middleware /admin). Optional in local; set in production.
APP_SESSION_SECRET=
ADMIN_LOGIN_EMAIL=admintech@mastersunion.org
# Lowercase SHA-256 hex digest of the admin password; never store the plaintext password.
ADMIN_LOGIN_PASSWORD_HASH=
# Server-side calls from Next route handlers to the API (defaults to NEXT_PUBLIC_API_URL).
API_INTERNAL_URL=