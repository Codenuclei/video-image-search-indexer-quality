# Same-origin proxy (app/api/proxy/[...path]/route.ts → FastAPI).
# Local: → http://127.0.0.1:8000 (API_PROXY_TARGET default)
# Railway: → https://dfi-backend-production.up.railway.app (buildArg)
# Avoids CORS; durable for long extract/generate (unlike Next rewrites).
NEXT_PUBLIC_API_URL=/api/proxy
# API_PROXY_TARGET=http://127.0.0.1:8000
